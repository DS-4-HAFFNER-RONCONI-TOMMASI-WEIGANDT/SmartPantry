{
  "App": {
    "SelfUrl": "https://localhost:44384",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.TP04.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=(LocalDb)\\MSSQLLocalDB;Database=TP04;Trusted_Connection=True;TrustServerCertificate=true"
  },
  "AuthServer": {
    "Authority": "https://localhost:44384",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "TP04_Swagger",
    "CertificatePassPhrase": "e7e00b51-9765-49e7-b689-91f3ced63a24"
  },
  "OpenFoodFacts": {
    "BaseUrl": "https://world.openfoodfacts.org/",
    "TimeoutSeconds": 10,
    "UserAgent": "SmartPantry/1.0 (+https://github.com/DS-4-HAFFNER-RONCONI-TOMMASI-WEIGANDT/SmartPantry)"
  },
